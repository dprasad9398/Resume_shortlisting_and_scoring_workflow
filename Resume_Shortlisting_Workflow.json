    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $json.output;\n\nconst cleanText = text\n  .replace(/^```json\\s*/, '')\n  .replace(/\\s*```$/, '')\n  .trim();\n\nconst result = JSON.parse(cleanText);\n\nreturn {\n  json: result\n};"
      },
