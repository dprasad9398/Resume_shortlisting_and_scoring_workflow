    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Next Steps: Your Resume Shortlisted",
        "message": "=<p>Dear {{ $json.candidate_name }},</p>  <p> Thank you for applying for the <strong>{{ $json['Applying for'] }}</strong> position. </p>  <p> We are pleased to inform you that your resume has been <strong>shortlisted</strong> for the next stage of our recruitment process. </p>  <p> Our initial screening indicates that your profile aligns well with the requirements of the position. </p>  <p><strong>Next Steps:</strong></p>  <ul>   <li>Our recruitment team will review your application.</li>   <li>You will receive further details regarding the interview process shortly.</li>   <li>Please keep your phone and email available for further communication.</li> </ul>  <p> Please note that this shortlisting is based on the initial resume screening and does not constitute a final selection or employment offer. </p>  <p> We appreciate your interest in joining our organization and look forward to connecting with you. </p>  <p> Best regards,<br> <strong>Recruitment Team</strong><br> HR Department </p>",
        "options": {
          "appendAttribution": false,
          "senderName": "HR Team"
        }
      },
